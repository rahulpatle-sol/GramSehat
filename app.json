{
  "expo": {
    "name": "GramSehat",
    "slug": "GramSehat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gramsehat",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "extra": {
      "googleClientId": "YOUR_GOOGLE_CLIENT_ID",
      "googleIosClientId": "YOUR_IOS_CLIENT_ID",
      "apiUrl": "YOUR_API_URL"
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4CAF50"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gramsehat.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "We use Face ID for secure authentication",
        "NSCameraUsageDescription": "We need camera access to scan medicines"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.gramsehat.app",
      "versionCode": 1,
      "permissions": ["CAMERA"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4CAF50"
        }
      ],
      "expo-camera"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
