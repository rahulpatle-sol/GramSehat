# =========================================
# GramSehat Backend - Neon PostgreSQL Setup
# =========================================

# Server Port
PORT=5000

# =========================================
# NEON POSTGRESQL DATABASE
# Get these from your Neon Dashboard:
# https://neon.tech/dashboard
# =========================================
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_NAME=gramsehat
DB_USER=your-neon-username
DB_PASSWORD=your-neon-password
DB_SSL=true

# =========================================
# JWT Authentication
# =========================================
JWT_SECRET=gramsehat_super_secret_key_change_this_32_chars_minimum

# =========================================
# OpenRouteService API (Required for directions)
# Get from: https://openrouteservice.org/signup
# =========================================
ORS_API_KEY=your_openrouteservice_api_key

# =========================================
# Google OAuth (Required for Google Sign-In)
# Get from: https://console.cloud.google.com/apis/credentials
# =========================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# =========================================
# Cloudinary (Optional - for image uploads)
# =========================================
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_KEY=your_cloudinary_key
CLOUDINARY_SECRET=your_cloudinary_secret

# =========================================
# Outbreak Detection Settings
# =========================================
OUTBREAK_THRESHOLD=10
OUTBREAK_WINDOW_HRS=48

# =========================================
# Connection String (Alternative to above)
# Uncomment and use this OR fill above fields
# =========================================
# DATABASE_URL=postgresql://user:password@host:5432/gramsehat?sslmode=require