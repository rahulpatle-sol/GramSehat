              "raw": "{\n  \"barcode\": \"8901234567890\",\n  \"name\": \"Dolo 650\",\n  \"genericName\": \"Paracetamol\",\n  \"manufacturer\": \"Macleods Pharmaceuticals\",\n  \"dosage\": \"650mg\",\n  \"uses\": [\"Fever\", \"Pain relief\", \"Headache\"],\n  \"sideEffects\": [\"Nausea\", \"Stomach pain\"],\n  \"price\": 30.00,\n  \"isVerified\": true\n}",
              "options": {
