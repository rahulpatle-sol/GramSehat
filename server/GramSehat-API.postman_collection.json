{
  "info": {
    "name": "GramSehat API",
    "description": "API Collection for GramSehat - Healthcare app for rural India",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "authToken",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9450001234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "send-otp"]
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9450001234\",\n  \"otp\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-otp"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.token) {",
                  "        pm.collectionVariables.set('authToken', jsonData.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Kumar\",\n  \"pincode\": \"224201\",\n  \"village\": \"Bela\",\n  \"district\": \"Ambedkar Nagar\",\n  \"state\": \"Uttar Pradesh\",\n  \"language\": \"hi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Symptoms",
      "item": [
        {
          "name": "Report Symptoms",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symptoms\": [\"fever\", \"headache\", \"cough\"],\n  \"primarySymptom\": \"fever\",\n  \"severity\": 2,\n  \"pincode\": \"224201\",\n  \"lat\": 26.8721,\n  \"lng\": 82.1987,\n  \"notes\": \"Patient has mild fever since yesterday\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/symptoms/report",
              "host": ["{{baseUrl}}"],
              "path": ["symptoms", "report"]
            }
          }
        },
        {
          "name": "Get Symptom History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/symptoms/history",
              "host": ["{{baseUrl}}"],
              "path": ["symptoms", "history"]
            }
          }
        }
      ]
    },
    {
      "name": "Outbreak",
      "item": [
        {
          "name": "Get Nearby Outbreaks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/outbreak/nearby?pincode=224201",
              "host": ["{{baseUrl}}"],
              "path": ["outbreak", "nearby"],
              "query": [
                {
                  "key": "pincode",
                  "value": "224201"
                }
              ]
            }
          }
        },
        {
          "name": "Get Outbreak History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/outbreak/history?pincode=224201&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["outbreak", "history"],
              "query": [
                {
                  "key": "pincode",
                  "value": "224201"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
    {
